{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "github>kachick/renovate-config-dprint#1.4.0"
  ],
  "commitMessagePrefix": "⬆️ ",
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchUpdateTypes": [
        "pin"
      ],
      "commitMessagePrefix": "📌 "
    },
    {
      "matchUpdateTypes": [
        "rollback"
      ],
      "commitMessagePrefix": "⬇️ "
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchPackageNames": [
        "@hebium-ui/*"
      ],
      "groupName": "hebium-ui",
      "minimumReleaseAge": "0 days"
    },
    {
      "matchPackageNames": [
        "lucide-solid",
        "dprint"
      ],
      "automerge": true
    },
    {
      "matchFileNames": [
        "dprint.json"
      ],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
